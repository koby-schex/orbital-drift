{
  "name": "orbital-drift",
  "version": "0.26.0",
  "private": true,
  "description": "Portrait mobile gravity-exploration game",
  "scripts": {
    "test": "node tests/static-smoke.mjs && node tests/release-readiness.mjs && node tests/offline-recovery.mjs && node tests/native-monetization.mjs",
