    "ios:sync": "npm run build:mobile && cap sync ios",
    "test:ios": "node tests/ios-wrapper.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  }
}
